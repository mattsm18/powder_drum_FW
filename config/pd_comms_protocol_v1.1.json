{
    "protocol_version": "1.1",

    "frame": {
        "sof_byte":          "0xAA",
        "version":           "0x02",
        "header_size_bytes": 5,
        "max_payload_bytes": 255,
        "timeout_ms":        100,
        "max_retries":       3
    },

    "direction": {
        "PC_TO_MCU": "0x01",
        "MCU_TO_PC": "0x02"
    },

    "msg_id": {
        "CMD_SET":   "0x01",
        "CMD_GET":   "0x02",
        "STATUS":    "0x10",
        "ACK":       "0xEE",
        "NACK":      "0xEF",
        "HEARTBEAT": "0xFF"
    },

     "nack_error": {
         "VERSION_MISMATCH": "0x01",
         "BAD_CRC":          "0x02",
         "UNKNOWN_MSG":      "0x03",
         "BAD_LEN":          "0x04",
         "BAD_DIRECTION":    "0x05",
         "UNKNOWN_PARAM":    "0x06",
         "READ_ONLY":        "0x07",
         "WRITE_ONLY":       "0x08"
     },

    "parameters": [
{
             "id": "0x00", "name": "protocolVersion", "label": "Protocol Version",
             "access": ["r"], "type": "float", "default": 1.0,
             "min": 0.0, "max": 10.0, "unit": "", "group": "system"
         },
        {
            "id": "0x01", "name": "targetAngularVelocity", "label": "Target Speed",
            "access": ["r", "w"], "type": "float", "default": 0.0,
            "min": 0.0, "max": 40.0, "unit": "rad/s", "group": "controller"
        },
        {
            "id": "0x02", "name": "accelerationRate", "label": "Acceleration",
            "access": ["r", "w"], "type": "float", "default": 5.0,
            "min": 0.1, "max": 40.0, "unit": "rad/s^2", "group": "controller"
        },
                {
            "id": "0x10", "name": "PIDproportionalGain", "label": "PID Proportional Gain",
            "access": ["r", "w"], "type": "float", "default": 1.0,
            "min": 0.0, "max": 20.0, "unit": "", "group": "controller"
        },
        {
            "id": "0x11", "name": "PIDintegralGain", "label": "PID Integral Gain",
            "access": ["r", "w"], "type": "float", "default": 2.0,
            "min": 0.0, "max": 10.0, "unit": "", "group": "controller"
        },
                {
            "id": "0x12", "name": "PIDderivativeGain", "label": "PID Derivative Gain",
            "access": ["r", "w"], "type": "float", "default": 2.0,
            "min": 0.0, "max": 10.0, "unit": "", "group": "controller"
        },
        {
            "id": "0x20", "name": "encoderAngularVelocity", "label": "Measured Speed",
            "access": ["r"], "type": "float", "default": 0.0,
            "min": 0.0, "max": 70.0, "unit": "rad/s", "group": "encoder"
        },
        {
            "id": "0x21", "name": "encoderAngleRadians", "label": "Measured Angle (Radians)",
            "access": ["r"], "type": "float", "default": 0.0,
            "min": -100.0, "max": 100.0, "unit": "radians", "group": "encoder"
        },
        {
            "id": "0x22", "name": "encoderAngleDegrees", "label": "Measured Angle (Degrees)",
            "access": ["r"], "type": "float", "default": 0.0,
            "min": -100.0, "max": 100.0, "unit": "degrees", "group": "encoder"
        },
        {
            "id": "0x40", "name": "motorAngularVelocity", "label": "Commanded Speed (motor)",
            "access": ["r"], "type": "float", "default": 0.0,
            "min": -100.0, "max": 100.0, "unit": "degrees", "group": "encoder"
        },
        {
            "id": "0x30", "name": "toggleLights", "label": "Toggle Lights",
            "access": ["r", "w"], "type": "bool", "default": 0.0,
            "min": 0.0, "max": 1.0, "unit": "", "group": "light"
        }
    ]
}