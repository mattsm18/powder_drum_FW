{
    "protocol_version": "1.0",

    "frame": {
        "sof_byte":          "0xAA",
        "version":           "0x01",
        "header_size_bytes": 5,
        "max_payload_bytes": 255,
        "timeout_ms":        100,
        "max_retries":       3
    },

    "direction": {
        "PC_TO_MCU": "0x01",
        "MCU_TO_PC": "0x02"
    },

    "msg_id": {
        "CMD_SET":   "0x01",
        "CMD_GET":   "0x02",
        "STATUS":    "0x10",
        "ACK":       "0xEE",
        "NACK":      "0xEF",
        "HEARTBEAT": "0xFF"
    },

    "nack_error": {
        "VERSION_MISMATCH": "0x01",
        "BAD_CRC":          "0x02",
        "UNKNOWN_MSG":      "0x03",
        "BAD_LEN":          "0x04"
    },

    "parameters": [
        {
            "id": "0x00", "name": "protocolVersion", "label": "Protocol Version",
            "access": ["r", "w"], "type": "float", "default": 1.0,
            "min": 0.0, "max": 10.0, "unit": "", "group": "system"
        },
        {
            "id": "0x01", "name": "setpoint", "label": "Setpoint",
            "access": ["r", "w"], "type": "float", "default": 0.0,
            "min": 0.0, "max": 30.0, "unit": "rad/s", "group": "motor"
        },
        {
            "id": "0x02", "name": "accelRate", "label": "Accel Rate",
            "access": ["r", "w"], "type": "float", "default": 5.0,
            "min": 0.1, "max": 20.0, "unit": "rad/s^2", "group": "motor"
        },
        {
            "id": "0x03", "name": "rampedSetpoint", "label": "Ramped Setpoint",
            "access": ["r"], "type": "float", "default": 0.0,
            "min": 0.0, "max": 70.0, "unit": "rad/s", "group": "motor"
        },
        {
            "id": "0x10", "name": "encoderAngularVelocity", "label": "Angular Velocity",
            "access": ["r"], "type": "float", "default": 0.0,
            "min": -100.0, "max": 100.0, "unit": "rad/s", "group": "motor"
        },
        {
            "id": "0x20", "name": "Kp", "label": "Kp",
            "access": ["r", "w"], "type": "float", "default": 1.0,
            "min": 0.0, "max": 20.0, "unit": "", "group": "motor"
        },
        {
            "id": "0x21", "name": "Ki", "label": "Ki",
            "access": ["r", "w"], "type": "float", "default": 2.0,
            "min": 0.0, "max": 10.0, "unit": "", "group": "motor"
        },
        {
            "id": "0x23", "name": "integralLimit", "label": "Integral Limit",
            "access": ["r", "w"], "type": "float", "default": 20.0,
            "min": 0.0, "max": 100.0, "unit": "", "group": "motor"
        },
        {
            "id": "0x24", "name": "deadband", "label": "Deadband",
            "access": ["r", "w"], "type": "float", "default": 0.0,
            "min": 0.0, "max": 5.0, "unit": "rad/s", "group": "motor"
        },
        {
            "id": "0x30", "name": "lights", "label": "Lights",
            "access": ["r", "w"], "type": "bool", "default": 0.0,
            "min": 0.0, "max": 1.0, "unit": "", "group": "io"
        }
    ]
}